{
  "office-rules": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|edit_file|write_file|delete_file|view_file|view_file_outline|read_file|grep_search|list_dir|find_by_name|run_command",
        "hooks": [{ "type": "command", "command": "python3 ./rules-hook", "timeout": 10 }]
      }
    ]
  }
}
